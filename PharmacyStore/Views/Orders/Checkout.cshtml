@model PharmacyStore.Models.Order
@{ ViewBag.Title = "Thanh toán"; }
<h2>Thanh toán</h2>

@using (Html.BeginForm("Checkout", "Orders", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="form-group">
        @Html.LabelFor(m => m.CustomerName, "Họ tên")
        @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Phone, "Số điện thoại")
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Address, "Địa chỉ")
        @Html.TextAreaFor(m => m.Address, 3, 50, new { @class = "form-control" })
    </div>

    <button class="btn btn-success">Đặt hàng</button>
    @Html.ActionLink("Về giỏ hàng", "Index", "Cart", null, new { @class = "btn btn-default" })
}
