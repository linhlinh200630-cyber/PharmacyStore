@model PharmacyStore.Models.Order

<h2>Đặt hàng thành công</h2>
<p>Mã đơn: @Model.OrderId</p>
<p>Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>

<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>SL</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Items)
        {
            <tr>
                <td>@d.ProductName</td>
                <td>@d.Quantity</td>
                <td>@d.UnitPrice.ToString("n0")</td>
                <td>@d.Subtotal.ToString("n0")</td>
            </tr>
        }
    </tbody>
</table>

<h4 class="text-right">Tổng: @Model.Total.ToString("n0") đ</h4>
