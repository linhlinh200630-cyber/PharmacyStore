<script>
(() => {
  // COUNTDOWN
  const end = new Date('@saleEnd.ToString("yyyy-MM-ddTHH:mm:ss")');
  const $h = document.getElementById('fs_h'),
        $m = document.getElementById('fs_m'),
        $s = document.getElementById('fs_s');
  const pad = n => (n < 10 ? '0' + n : '' + n);
  function tick(){
    const now = new Date();
    let t = end - now; if (t < 0) t = 0;
    const hh = Math.floor(t / 36e5);
    const mm = Math.floor((t % 36e5) / 6e4);
    const ss = Math.floor((t % 6e4) / 1e3);
    $h.textContent = pad(hh); $m.textContent = pad(mm); $s.textContent = pad(ss);
  }
  tick(); setInterval(tick, 1000);

  // SCROLLERS
  const pair = (idPrev,idScroller,idNext,step) => {
    const prev = document.getElementById(idPrev),
          scroller = document.getElementById(idScroller),
          next = document.getElementById(idNext);
    if (prev) prev.onclick = () => scroller.scrollBy({ left: -step, behavior: 'smooth' });
    if (next) next.onclick = () => scroller.scrollBy({ left:  step, behavior: 'smooth' });
  };
  pair('fs_prev','fs_scroller','fs_next',260);
  pair('np_prev','np_scroller','np_next',240);
  pair('bs_prev','bs_scroller','bs_next',240);
})();
</script>