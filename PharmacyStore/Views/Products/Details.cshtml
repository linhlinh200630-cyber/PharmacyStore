@model PharmacyStore.Models.Product

@{
    ViewBag.Title = Model.Name;

    var price = Model.Price;
}

<div class="row lc-detail">
    <div class="col-sm-5">
        <img class="img-responsive lc-detail-img"
             src="@Model.ImageUrl"
             alt="@Model.Name" />
    </div>
        
    <div class="col-sm-7">
        <h1 class="lc-detail-name">@Model.Name</h1>

        <div class="lc-detail-price">
            <span class="lc-price-now">@price.ToString("n0") đ</span>
        </div>


        <ul class="lc-detail-meta list-unstyled">
            <li>Quy cách: @Model.Unit</li>
            <li>Mã SP: @Model.ProductId</li>
            <li>Tình trạng: <b>Còn hàng</b></li>
        </ul>

        <div class="lc-detail-actions">
            <a class="btn btn-lg btn-primary"
               href="@Url.Action("Add", "Cart", new { id = Model.ProductId, qty = 1, returnUrl = Request.RawUrl })">
                Chọn mua
            </a>


            <a class="btn btn-default"
               href="@Url.Action("Index", "Products")">
                Xem thêm sản phẩm
            </a>
        </div>
        <div class="lc-detail-desc">
            <h4>Công dụng</h4>
            <p>@Html.Raw(Model.Description ?? "Đang cập nhật...")</p>
        </div>

    </div>
</div>
