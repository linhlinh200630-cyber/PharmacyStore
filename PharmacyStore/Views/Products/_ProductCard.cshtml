@model PharmacyStore.Models.Product

<div class="col-md-3 col-sm-4 col-6 mb-4">
    <div class="card h-100 shadow-sm">

        <!--  BỌC HÌNH + TÊN + GIÁ TRONG <a> -->
        <a href="@Url.Action("Details", "Products", new { id = Model.ProductId })"
           class="text-decoration-none text-dark"
           style="display:block; cursor:pointer;">

            @{
                // Nếu ImageUrl trong DB là kiểu: "Content/img/top/tenfile.jpg"
                // thì mình thêm "~/" ở đầu để nó thành đường dẫn gốc của web.
                var imgPath = string.IsNullOrEmpty(Model.ImageUrl)
                    ? Url.Content("~/Content/img/no-image.png")    // ảnh dự phòng
                    : Url.Content("~/" + Model.ImageUrl.TrimStart('~', '/'));
            }

            <img src="@imgPath"
                 class="card-img-top img-fluid"
                 alt="@Model.Name" />


            <div class="card-body">
                <h6 class="card-title">@Model.Name</h6>
                <p class="card-text mb-0 fw-bold text-danger">
                    @Model.Price.ToString("N0") đ
                </p>
            </div>

        </a>

    </div>
</div>
