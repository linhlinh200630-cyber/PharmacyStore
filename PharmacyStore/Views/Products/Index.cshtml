@model IEnumerable<PharmacyStore.Models.Product>
@{
    ViewBag.Title = "Sản phẩm";
    var q = Request["q"];
}
<div class="row">
    <aside class="col-sm-3 lc-filter">
        <h4>Bộ lọc</h4>
        <form method="get">
            <div class="form-group">
                <label>Tìm kiếm</label>
                <input class="form-control" name="q" value="@q" placeholder="Tên sản phẩm..." />
            </div>
            <div class="form-group">
                <label>Khoảng giá</label>
                <select class="form-control" name="price">
                    <option value="">Tất cả</option>
                    <option value="0-100000">Dưới 100k</option>
                    <option value="100000-300000">100k – 300k</option>
                    <option value="300000-9999999">Trên 300k</option>
                </select>
            </div>
            <button class="btn btn-lc btn-block">Áp dụng</button>
        </form>
    </aside>

    <section class="col-sm-9">
        <div class="lc-section-head">
            <h3>@(String.IsNullOrWhiteSpace(q) ? "Tất cả sản phẩm" : "Kết quả cho: " + q)</h3>
        </div>
        <div class="row lc-product-grid">
            @foreach (var p in Model ?? Enumerable.Empty<PharmacyStore.Models.Product>())
            {
                <div class="col-md-3 col-sm-4 col-6 mb-4">
                    <div class="card h-100 shadow-sm">

                        <a href="@Url.Action("Details", "Products", new { id = p.ProductId })"
                           class="text-decoration-none text-dark">
                            <img src="@p.ImageUrl" class="card-img-top img-fluid" alt="@p.Name" />
                            <div class="card-body">
                                <h6>@p.Name</h6>
                                <p class="fw-bold text-danger">@p.Price.ToString("N0") đ</p>
                            </div>
                        </a>

                        @* 👉 Hiện nút Sửa / Xóa cho Admin *@
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="p-2 d-flex gap-2">
                                <a class="btn btn-warning btn-sm w-50"
                                   href="@Url.Action("Edit", "Products", new { id = p.ProductId })">
                                    Sửa
                                </a>

                                <a class="btn btn-danger btn-sm w-50"
                                   href="@Url.Action("Delete", "Products", new { id = p.ProductId })">
                                    Xóa
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>
